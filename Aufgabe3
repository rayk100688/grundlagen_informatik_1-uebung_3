def letzteziffern (zahl):
    if zahl <10:                                 # Zahl ist einstellig
        return 0
    elif zahl <100:	                             # Zahl ist zweistellig
        return zahl%10                           # Ganzzahliger Rest der Division durch 10 (letzte Ziffer)
    else:                                        #Zahl ist mindestens dreistellig
        return zahl%100                          # Ganzzahliger Rest der Division durch 100 (letzte 2 Ziffern)
