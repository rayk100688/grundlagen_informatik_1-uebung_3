def gutebesserung (gesundheitszustand):
    if gesundheitszustand == "gesund":
        print ("bitte besuchen Sie die Vorlesung/Übung")
    elif gesundheitszustand == "krank":
        print ("gute Besserung")
    else:
        print ("Werter Nutzer, für eine präzise Antwort übergeben Sie bitte entweder \"krank\" oder \"gesund\" als Parameter")
